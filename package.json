{
  "name": "n8n-workflow-visualizer",
  "private": true,
  "version": "1.0.0",
  "description": "Privacy-first browser visualizer and structural simulator for n8n workflow exports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConfusedJonas/n8n-workflow-visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/ConfusedJonas/n8n-workflow-visualizer/issues"
  },
  "homepage": "https://github.com/ConfusedJonas/n8n-workflow-visualizer#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "e2e": "playwright test",
    "screenshot": "node scripts/capture-readme.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@xyflow/react": "^12.8.5",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "simple-icons": "^16.32.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dagre": "^0.7.52",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.1"
  }
}
